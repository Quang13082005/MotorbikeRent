# ==============================================================================
# MOTORENT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép tệp này thành .env hoặc thiết lập các biến môi trường tương ứng trong hệ thống.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env HOẶC GIÁ TRỊ THẬT LÊN GITHUB.
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/motorent_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Server Configuration
SERVER_PORT=8080
JPA_DDL_AUTO=validate

# JWT Security
JWT_SECRET=your_256_bit_secure_jwt_secret_key_here

# Gmail SMTP Configuration (Quên mật khẩu & OTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Google Cloud Vision API Key (Quét CCCD tự động)
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here

# PayOS Payment Gateway (Thanh toán cọc VietQR)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# OpenAI API Key (Tùy chọn cho tính năng gợi ý thông minh)
OPENAI_API_KEY=your_openai_api_key_here
